# Copy to docker/.env (gitignored) and set your own values.
# Generate a password with: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=opspulse
POSTGRES_USER=opspulse

OPSPULSE_ENVIRONMENT=local
OPSPULSE_SEED_DEMO_DATA=true
# Shown in the UI sidebar; e.g. GIT_SHA=$(git rev-parse HEAD) docker compose up --build
GIT_SHA=local
